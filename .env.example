# ------------------------------------------------------------------
# Social Media Studio environment.
# Copy to .env and fill in real values. The .env file is gitignored.
# ------------------------------------------------------------------

# SQLite database file location. "sqlite:///data/social_studio.db" is the default.
DATABASE_URL=sqlite:///data/social_studio.db

# Publisher <-> adapter registry. Format: <platform>=<AdapterClass> separated by commas.
# Platforms listed here are the only ones the app will generate/schedule for.
# Swapping an adapter is a config change only - no code touched.
# Valid classes: TelegramPublisher, MockXPublisher, MockLinkedInPublisher, MockInstagramPublisher
PUBLISHERS=telegram=TelegramPublisher,x=MockXPublisher,linkedin=MockLinkedInPublisher

# --- Telegram (the one REAL free platform) -------------------------
# Create a bot with @BotFather, put the token here.
# chat_id: your own channel/group (bot permits) e.g. @my_test_channel or -1001234567890
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Scheduler ------------------------------------------------------
# How often (seconds) the durable worker polls for due slots.
SCHEDULER_POLL_SECONDS=5

# Test/demo aid: force the worker to exit AFTER publishing N slots in a batch,
# simulating a crash mid-batch. 0 = never. Used to prove crash recovery.
SCHEDULER_CRASH_AFTER=0

# A slot whose publish attempt has been stuck in "publishing" for this many
# seconds is assumed to be from a dead worker and gets retried.
SCHEDULER_CRASH_RECOVERY_SECONDS=300